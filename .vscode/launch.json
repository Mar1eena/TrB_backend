{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            // "console": "integratedTerminal",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "TA-Lib: RSI Function API",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/internal/services/indicators/talib_sandbox/rsi_func.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/internal/services/indicators/talib_sandbox",
            "justMyCode": false
        },
        {
            "name": "TA-Lib: RSI Stream API",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/internal/services/indicators/talib_sandbox/rsi_stream.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/internal/services/indicators/talib_sandbox",
            "justMyCode": false
        },
        {
            "name": "TA-Lib: compare all",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/internal/services/indicators/talib_sandbox/compare_all.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/internal/services/indicators/talib_sandbox",
            "justMyCode": false
        },
        {
            "name": "Indicators manage",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/internal/services/indicators/manage/cmd/main.go",
            "cwd": "${workspaceFolder}",
            "env": {
                "PORT": "9093",
                "INDICATORS_PORT": "9093"
            }
        },
        {
            "name": "Indicators calculation",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/internal/services/indicators/calculation/main.py",
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "envFile": "${workspaceFolder}/.env",
            "env": {
                "PYTHONPATH": "${workspaceFolder}/internal/services/indicators/calculation",
                "INDICATORS_NATS_SUBJECT": "TrB.indicators.tasks"
            },
            "justMyCode": false
        },
        {
            "name": "Historical Candle",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/internal/services/historicCandle/cmd/main.go",
            "cwd": "${workspaceFolder}",
        },
        {
            "name": "Historical Candle Scheduler",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/internal/services/historicCandle_scheduler/cmd/main.go",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Invest",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/internal/services/api/invest/cmd/main.go",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "Data",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/internal/services/api/data/cmd/main.go",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "NATS",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/internal/services/api/nats/cmd/main.go",
            "cwd": "${workspaceFolder}"
        },
        {
            "name": "ClickHouse",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/internal/services/clickhouse/cmd/main.go",
            "cwd": "${workspaceFolder}",
            "env": {
                "PORT": "50051"
            }
        }
    ]
}
